# Copy to your shell (or .env) and fill in what you use.
# Only ONE provider setup is active at a time:
#   API_BASE_URL set  -> custom OpenAI-compatible provider
#   OPENROUTER_API_KEY -> OpenRouter (Anthropic-format API)
#   ANTHROPIC_API_KEY  -> Anthropic direct

# --- Option 1: custom OpenAI-compatible provider (company gateway, Ollama, vLLM, ...) ---
API_BASE_URL=https://api.siemens.com/llm/v1
API_KEY=your-api-key
MODEL=your-model-name

# --- Option 2: OpenRouter ---
#OPENROUTER_API_KEY=your-openrouter-key
#MODEL=anthropic/claude-opus-4.5

# --- Option 3: Anthropic direct ---
#ANTHROPIC_API_KEY=your-anthropic-key
#MODEL=claude-opus-4-5
